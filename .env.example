# CariJajan — Environment Variables Template
# Salin file ini menjadi local.properties dan isi dengan nilai nyata.
# JANGAN commit local.properties ke git! mengerti

# ── Supabase ──────────────────────────────────────────────────────────────────
# Dapatkan dari: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# JANGAN taruh service_role key di app Android — hanya untuk Edge Functions/server
# SUPABASE_SERVICE_ROLE_KEY=...  ← server-side only!

# ── MapTiler ──────────────────────────────────────────────────────────────────
# Dapatkan dari: https://cloud.maptiler.com/account/keys/
# Free tier: 100.000 tile requests/bulan
MAPTILER_API_KEY=YOUR_MAPTILER_API_KEY

# ── Google OAuth (opsional — untuk login pembeli via Google) ──────────────────
# Dapatkan dari: Google Cloud Console → APIs & Services → Credentials
# Aktifkan juga di Supabase: Authentication → Providers → Google
GOOGLE_WEB_CLIENT_ID=YOUR_GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com
